    <panel_attributes>EstadoPartida {internal sealed}
--
+ Id: Guid
+ Revision: int
+ Fase: string
+ NumeroRonda, NumeroCombate: int?
+ IdSolicitud: Guid?
+ MotivoFin, Ganador, AbandonoDe: string?
+ Participantes: List&lt;ParticipantePartida&gt;
+ Cartas: List&lt;CartaPartida&gt;
+ Rondas: List&lt;RondaPartida&gt;
+ Combates: List&lt;CombatePartida&gt;
+ Solicitudes: List&lt;SolicitudPartida&gt;
--
Estado de dominio reanudable, sin entidades EF ni DTO HTTP.
Sin hashes, presencia temporal ni recibos.</panel_attributes>
    <additional_attributes />
  </element>
  <element>
    <id>UMLClass</id>

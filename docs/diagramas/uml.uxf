    <panel_attributes>AlmacenPartidas {internal sealed, IDisposable}
--
~ Infraestructura: SqliteJuego {readOnly}
--
~ AlmacenPartidas(cadena: string)
~ AlmacenPartidas(infraestructura: SqliteJuego)
~ CrearPartida(): PartidaCreada
~ Ejecutar&lt;T&gt;(id: Guid, escritura: bool, accion: Func&lt;UnidadPartida, T&gt;): T
~ Autenticar(id: Guid, credencial: string?): string
~ RegistrarNombre(id: Guid, credencial: string?, nombre: string, comprobar: Action&lt;string&gt;): string
~ ExigirParticipante(id: Guid, rol: string): void
~ ReemplazarCredencial(id: Guid, rol: string): string
+ Dispose(): void
--
Mapea entidades al EstadoPartida y guarda estado/operaciones.
UnidadPartida ofrece Partida, autenticacion, recibos y copia del catalogo.
No decide ganadores ni turnos.</panel_attributes>
    <additional_attributes />
  </element>

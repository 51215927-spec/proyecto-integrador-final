    <panel_attributes>AdministradorSesiones {internal sealed}
--
- sesiones: Dictionary&lt;(Guid, string), Sesion&gt; {readOnly}
~ Sincronizacion: object {readOnly}
--
~ AdministradorSesiones(almacen: AlmacenPartidas, reloj: TimeProvider)
~ Incorporar(id: Guid, credencial: string?, datos: Incorporacion): Sesion
~ Renovar(id: Guid, credencial: string?, idSesion: Guid): void
~ CerrarSesion(id: Guid, rol: string): void
~ ReemplazarCredencial(id: Guid, rol: string): string
~ AmbosPresentes(id: Guid): bool
~ ExigirSesion(id: Guid, rol: string, idSesion: Guid): Sesion
--
Presencia temporal en memoria, vencimiento de 15 segundos.
Comparte coordinacion con acceso y escritura; invalida tras guardar hash.</panel_attributes>
    <additional_attributes />
  </element>

    <panel_attributes>CoordinadorPartidas {internal sealed}
--
~ CoordinadorPartidas(almacen: AlmacenPartidas,
    sesiones: AdministradorSesiones, catalogo: CatalogoPersonajes)
--
~ CrearPartida(): PartidaCreada
~ Iniciar(id: Guid): void
~ Cancelar(id: Guid): void
~ Elegir(id: Guid, credencial: string?, idSesion: Guid, datos: Eleccion): Confirmacion
~ ConsultarRecibo(id: Guid, credencial: string?, idSesion: Guid, idOperacion: Guid): Recibo
~ Abandonar(id: Guid, credencial: string?, idSesion: Guid): void
~ Presentacion(id: Guid, credencial: string?, idSesion: Guid): PresentacionVisible
--
Coordina acceso, presencia, recuperacion de recibos y dominio.
No expone DbContext ni implementa reglas o proyeccion.</panel_attributes>
    <additional_attributes />
  </element>
  <element>
    <id>UMLClass</id>
